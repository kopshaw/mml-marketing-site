---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import PressStrip from '../components/PressStrip.astro';
import PainsSection from '../components/PainsSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import FrameworkSection from '../components/FrameworkSection.astro';
import ClientsSection from '../components/ClientsSection.astro';
import PodcastSection from '../components/PodcastSection.astro';
import CTASection from '../components/CTASection.astro';
import ContactSection from '../components/ContactSection.astro';
import { SITE, SERVICES, FREEDOM_DOMAINS } from '../data/site';

const title = 'Rev OS Installation for $500K–$25M Operators | Metric Mentor Labs';
const description = 'Metric Mentor Labs installs the Rev OS — the Revenue Playbooks Operating System — into businesses doing $500K to $25M. Documented playbooks, dashboards, and operating rhythms that make the founder less necessary, not more. revenue. by. design.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE.url}#steve-kopshaw`,
  name: SITE.founder.name,
  alternateName: 'The Metric Mentor',
  jobTitle: SITE.founder.jobTitle,
  email: SITE.founder.email,
  url: SITE.url,
  sameAs: SITE.founder.sameAs,
  worksFor: { '@id': `${SITE.url}#organization` },
  description: SITE.founder.bio,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Polytechnic University' },
  award: ['ClickFunnels Two Comma Club'],
  knowsAbout: [
    'Revenue Operating Systems', 'Rev OS', 'F.R.E.E.D.O.M. Framework',
    'Fractional COO', 'Fractional VP Growth',
    'Business systemization', 'SOP development', 'Scaling founder-led businesses',
    'Revenue operations', 'Profit per acquisition',
  ],
};

const serviceCatalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Metric Mentor Labs Service Ladder',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'Offer',
    position: i + 1,
    price: s.price,
    itemOffered: {
      '@type': 'Service',
      name: s.title,
      description: s.description,
      url: `${SITE.url}/services/${s.slug}`,
      provider: { '@id': `${SITE.url}#organization` },
    },
  })),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is a Rev OS?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A Rev OS — Revenue Operating System — is a documented set of playbooks, dashboards, scorecards, and operating rhythms that allows a business to generate revenue predictably and run without depending on the founder being in the room. Metric Mentor Labs installs the Rev OS into businesses doing $500K to $25M.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the F.R.E.E.D.O.M. Framework?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The F.R.E.E.D.O.M. Framework is the proprietary methodology behind every Metric Mentor Labs engagement. It scores a business across seven domains — Financial Foundations, Revenue Systems, Execution Engine, Employee & Team Excellence, Data & Decisions, Operations & Optimization, and Marketing & Market Position — and uses the lowest-scoring domain as the highest-leverage fix point.',
      },
    },
    {
      '@type': 'Question',
      name: 'Who is Metric Mentor Labs for?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Owner-operators and founders running businesses with $500K to $25M in annual revenue who have proven product-market fit but are still the bottleneck for sales, ops, hiring, or strategy. Industry-agnostic — same diagnostics across financial planning, fitness, health and wellness coaching, agencies, and B2B service businesses.',
      },
    },
    {
      '@type': 'Question',
      name: 'How much does Metric Mentor Labs cost?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The FREEDOM Diagnostic is free. The MML Toolbox is $97/month. RISE CRM is $97/month. Social Growth Bot is $247/month. Quarterly Advisory is $2,000/month. Rev OS Installation is custom and project-based. Fractional Growth Leadership typically ranges from $2,000 to $15,000+ per month depending on scope.',
      },
    },
    {
      '@type': 'Question',
      name: 'How is Metric Mentor Labs different from a business coach or EOS Implementer?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Coaches sell motivation and accountability calls; MML installs infrastructure. EOS Implementers install Traction\'s framework focused on meeting cadence; MML\'s F.R.E.E.D.O.M. Framework covers seven domains end-to-end with installed dashboards, playbooks, and SOPs — not just meeting structures. The objective of every MML engagement is to make the founder less necessary, not more.',
      },
    },
  ],
};
---

<Layout title={title} description={description} schemas={[personSchema, serviceCatalogSchema, faqSchema]}>
  <HeroSection />
  <PressStrip />
  <PainsSection limit={9} />
  <AboutSection />
  <ServicesSection />
  <FrameworkSection />
  <ClientsSection />
  <PodcastSection />
  <CTASection />
  <ContactSection />
</Layout>
