---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';

const title = 'Blog — Insights from Metric Mentor Labs';
const description = 'Articles on Rev OS installation, the F.R.E.E.D.O.M. Framework, leadership development, revenue growth, and strategic execution for founder-led businesses.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog` },
  ],
};
---

<Layout title={title} description={description} schemas={[breadcrumbSchema]}>
  <section class="pt-32 pb-16 px-6 md:px-12 max-w-4xl mx-auto">
    <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">Blog</p>
    <h1 class="text-4xl md:text-6xl font-display text-foreground mb-6">Insights</h1>
    <p class="font-body text-xl text-muted-foreground leading-relaxed mb-12">
      Field notes from installing the Rev OS into founder-led businesses. Coming soon.
    </p>
    <div class="border border-dashed border-border rounded-sm p-12 text-center">
      <p class="font-body text-muted-foreground">
        First articles publish in the coming weeks. Subscribe via the contact form to be notified.
      </p>
    </div>
  </section>
</Layout>
