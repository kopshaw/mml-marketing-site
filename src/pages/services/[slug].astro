---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE, SERVICES } from '../../data/site';

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = SERVICES.find((s) => s.slug === slug)!;

const title = `${service.title} | Metric Mentor Labs`;
const description = service.description;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.description,
  url: `${SITE.url}/services/${service.slug}`,
  provider: { '@id': `${SITE.url}#organization` },
  areaServed: 'United States',
  serviceType: service.title,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services` },
    { '@type': 'ListItem', position: 3, name: service.title, item: `${SITE.url}/services/${service.slug}` },
  ],
};

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
---

<Layout title={title} description={description} schemas={[serviceSchema, breadcrumbSchema]}>
  <section class="pt-32 pb-16 px-6 md:px-12 max-w-4xl mx-auto">
    <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">Service</p>
    <h1 class="text-4xl md:text-6xl font-display text-foreground mb-6">{service.title}</h1>
    <p class="font-body text-xl text-muted-foreground leading-relaxed mb-8">
      {service.short}
    </p>
    <p class="font-body text-base text-foreground/80 leading-relaxed mb-12">
      {service.description}
    </p>

    <a
      href="/contact"
      class="inline-block gradient-accent text-primary-foreground font-body text-base font-semibold tracking-wider uppercase px-10 py-4 rounded-sm glow-accent hover:opacity-90 transition-opacity"
    >
      Start the conversation
    </a>
  </section>

  <section class="px-6 md:px-12 py-16 max-w-7xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-display text-foreground mb-8">Other engagements</h2>
    <div class="grid md:grid-cols-3 gap-6">
      {otherServices.map((s) => (
        <a
          href={`/services/${s.slug}`}
          class="group block border border-border rounded-sm p-6 hover:border-primary/40 transition-all"
        >
          <h3 class="font-display text-xl text-foreground mb-2">{s.title}</h3>
          <p class="font-body text-sm text-muted-foreground leading-relaxed">{s.short}</p>
          <p class="font-body text-xs tracking-wider uppercase mt-3 text-primary">Learn more &rarr;</p>
        </a>
      ))}
    </div>
  </section>

  <CTASection />
</Layout>
