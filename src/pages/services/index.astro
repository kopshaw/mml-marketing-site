---
import Layout from '../../layouts/Layout.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import PainsSection from '../../components/PainsSection.astro';
import CTASection from '../../components/CTASection.astro';
import { SITE, SERVICES } from '../../data/site';

const title = 'Services & Service Ladder — Free Diagnostic to Fractional Leadership | Metric Mentor Labs';
const description = 'From the free FREEDOM Diagnostic ($0) to Fractional Growth Leadership ($2K–$15K+/mo). Seven tiers built around the Rev OS and the F.R.E.E.D.O.M. Framework. Industry-agnostic. $500K–$25M operators.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${SITE.url}/services/${s.slug}`,
    name: s.title,
    description: s.description,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/services` },
  ],
};
---

<Layout title={title} description={description} schemas={[itemListSchema, breadcrumbSchema]}>
  <div class="pt-32"></div>
  <ServicesSection />
  <PainsSection
    heading="What this work actually fixes"
    subhead="Every service tier targets a specific class of operator pain. If any of these sound like your business, the diagnostic will tell you exactly which tier matches the constraint."
  />
  <CTASection />
</Layout>
