---
// Dynamic route for every resource article. Pulls from Astro's content collection,
// renders MDX/Markdown body, builds full schema (Article + BreadcrumbList + FAQPage),
// and emits an "AEO answer" block at the top extractable by AI crawlers.

import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const items = await getCollection('resources');
  return items.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: CollectionEntry<'resources'>; }
const { entry } = Astro.props;
const { Content } = await entry.render();

// Build related items (same cluster or explicitly named)
const all = await getCollection('resources');
const related = all
  .filter((r) => r.slug !== entry.slug)
  .filter((r) =>
    entry.data.related.includes(r.slug) ||
    r.data.cluster === entry.data.cluster
  )
  .slice(0, 4);

const clusterLabels: Record<string, string> = {
  'revenue-operations': 'Revenue Operations',
  'business-systems': 'Business Systems & SOPs',
  'fractional-leadership': 'Fractional Leadership',
  'operator-mindset': 'Operator Mindset',
  'scaling-frameworks': 'Scaling Frameworks',
};

const url = `${SITE.url}/resources/${entry.slug}`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  url,
  author: { '@id': `${SITE.url}#steve-kopshaw` },
  publisher: { '@id': `${SITE.url}#organization` },
  datePublished: entry.data.publishedAt,
  dateModified: entry.data.updatedAt || entry.data.publishedAt,
  keywords: entry.data.keywords.join(', '),
  mainEntityOfPage: url,
};

const faqSchema = entry.data.faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: `${SITE.url}/resources` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
  ],
};

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Layout
  title={`${entry.data.title} | Metric Mentor Labs`}
  description={entry.data.description}
  schemas={schemas}
  ogType="article"
  publishedTime={entry.data.publishedAt}
  modifiedTime={entry.data.updatedAt}
>
  <article class="pt-32 pb-12 px-6 md:px-12">
    <div class="max-w-3xl mx-auto">
      <p class="font-body text-xs tracking-[0.3em] text-primary uppercase mb-3">
        {entry.data.pillar && 'Pillar · '}{clusterLabels[entry.data.cluster]}
      </p>
      <h1 class="text-4xl md:text-6xl font-display text-foreground mb-6 leading-[1.05]">
        {entry.data.title}
      </h1>
      <p class="font-body text-lg md:text-xl text-muted-foreground leading-relaxed mb-8">
        {entry.data.description}
      </p>

      <!-- AEO answer block — short, extractable answer at top of every article -->
      <div class="bg-card border-l-4 border-primary rounded-sm p-5 mb-12">
        <p class="font-body text-xs tracking-wider uppercase text-primary mb-2">Short answer</p>
        <p class="font-body text-base text-foreground/90 leading-relaxed">
          {entry.data.aeoAnswer}
        </p>
      </div>

      <div class="prose prose-invert max-w-none font-body text-foreground/85
                  prose-headings:font-display prose-headings:text-foreground prose-headings:tracking-wide
                  prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4
                  prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
                  prose-p:leading-relaxed prose-li:leading-relaxed
                  prose-a:text-primary prose-a:no-underline hover:prose-a:text-accent
                  prose-strong:text-foreground prose-em:text-accent
                  prose-blockquote:border-primary prose-blockquote:text-foreground/80">
        <Content />
      </div>

      {entry.data.faq.length > 0 && (
        <section class="mt-16 pt-10 border-t border-border/30">
          <h2 class="text-2xl md:text-3xl font-display text-foreground mb-6">FAQ</h2>
          <div class="space-y-5">
            {entry.data.faq.map((f) => (
              <details class="bg-card border border-border rounded-sm p-5 group">
                <summary class="font-body font-semibold text-foreground cursor-pointer list-none flex items-start justify-between gap-3">
                  <span>{f.q}</span>
                  <span class="text-primary group-open:rotate-45 transition-transform shrink-0">+</span>
                </summary>
                <p class="font-body text-sm text-muted-foreground leading-relaxed mt-3">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mt-16 pt-10 border-t border-border/30 text-center">
        <h2 class="text-2xl md:text-3xl font-display text-foreground mb-3">Run the diagnostic.</h2>
        <p class="font-body text-muted-foreground mb-6 max-w-xl mx-auto">
          Get a 7-domain score on your business in 10–15 minutes. No sales call required.
        </p>
        <a href={SITE.diagnosticUrl} class="inline-block gradient-accent text-primary-foreground font-body text-sm font-semibold tracking-wider uppercase px-10 py-4 rounded-sm hover:opacity-90 transition-opacity">
          Take the FREEDOM Diagnostic
        </a>
      </section>

      {related.length > 0 && (
        <section class="mt-16 pt-10 border-t border-border/30">
          <h2 class="text-2xl md:text-3xl font-display text-foreground mb-6">Related</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {related.map((r) => (
              <a href={`/resources/${r.slug}`} class="group block bg-card/50 border border-border rounded-sm p-5 hover:border-primary/40 transition-colors">
                <p class="font-body text-[10px] tracking-wider uppercase text-primary mb-2">{clusterLabels[r.data.cluster]}</p>
                <h3 class="font-display text-lg text-foreground mb-1">{r.data.title}</h3>
                <p class="font-body text-xs text-muted-foreground leading-relaxed">{r.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</Layout>
