---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page not found | Metric Mentor Labs" noindex={true}>
  <section class="min-h-[70vh] flex items-center justify-center px-6 text-center">
    <div>
      <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">404</p>
      <h1 class="text-5xl md:text-7xl font-display text-foreground mb-4">Page not found</h1>
      <p class="font-body text-muted-foreground mb-8">The page you&rsquo;re looking for doesn&rsquo;t exist.</p>
      <a href="/" class="gradient-accent text-primary-foreground font-body text-sm font-semibold tracking-wider uppercase px-8 py-3 rounded-sm hover:opacity-90 transition-opacity">
        Back to home
      </a>
    </div>
  </section>
</Layout>
