---
import Layout from '../layouts/Layout.astro';
import { FAQ_GROUPS } from '../data/faq';
import { SITE } from '../data/site';

const title = 'FAQ — Rev OS, Fractional Leadership, Scaling, and Operating Systems | Metric Mentor Labs';
const description = '50+ questions on the Rev OS, the F.R.E.E.D.O.M. Framework, fractional COO/growth leadership, scaling past $1M / $3M / $10M, SOPs, role scorecards, KPIs, and the operator mindset. Built for $500K–$25M operators.';

// Flatten all FAQ items into one big FAQPage schema
const allItems = FAQ_GROUPS.flatMap((g) => g.items);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: `${SITE.url}/faq` },
  ],
};
---

<Layout title={title} description={description} schemas={[faqSchema, breadcrumbSchema]}>
  <section class="pt-32 pb-12 px-6 md:px-12 max-w-4xl mx-auto">
    <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">FAQ</p>
    <h1 class="text-4xl md:text-6xl font-display text-foreground mb-6">
      Operator Questions, Answered.
    </h1>
    <p class="font-body text-lg md:text-xl text-muted-foreground leading-relaxed mb-8">
      Direct answers to the questions $500K–$25M operators actually ask &mdash; about the Rev OS,
      the F.R.E.E.D.O.M. Framework, fractional leadership, scaling, SOPs, KPIs, and what to do
      when the business is stuck. {allItems.length} questions, no fluff.
    </p>

    <nav aria-label="FAQ groups" class="bg-card border border-border rounded-sm p-5 mb-12">
      <p class="font-body text-xs tracking-wider uppercase text-primary mb-3">Jump to</p>
      <ul class="grid sm:grid-cols-2 gap-2">
        {FAQ_GROUPS.map((g, i) => (
          <li>
            <a href={`#group-${i}`} class="font-body text-sm text-foreground hover:text-primary transition-colors">
              &rarr; {g.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  {FAQ_GROUPS.map((group, i) => (
    <section id={`group-${i}`} class="px-6 md:px-12 py-10 max-w-4xl mx-auto border-t border-border/30">
      <h2 class="text-2xl md:text-3xl font-display text-foreground mb-2">{group.title}</h2>
      {group.description && (
        <p class="font-body text-sm text-muted-foreground mb-8">{group.description}</p>
      )}
      <div class="space-y-3">
        {group.items.map((item) => (
          <details class="bg-card border border-border rounded-sm p-5 group">
            <summary class="font-body font-semibold text-foreground cursor-pointer list-none flex items-start justify-between gap-4">
              <span>{item.q}</span>
              <span class="text-primary group-open:rotate-45 transition-transform shrink-0 text-lg leading-none mt-0.5">+</span>
            </summary>
            <p class="font-body text-sm text-muted-foreground leading-relaxed mt-4">{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  ))}

  <section class="px-6 md:px-12 py-16 max-w-3xl mx-auto text-center border-t border-border/30 mt-8">
    <h2 class="text-3xl md:text-4xl font-display text-foreground mb-4">Question we haven&rsquo;t answered?</h2>
    <p class="font-body text-muted-foreground mb-8 leading-relaxed">
      The FREEDOM Diagnostic surfaces the questions specific to your business &mdash; with a
      score and a prioritized fix list, not a generic answer.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={SITE.diagnosticUrl} class="inline-block gradient-accent text-primary-foreground font-body text-sm font-semibold tracking-wider uppercase px-8 py-3 rounded-sm hover:opacity-90 transition-opacity">
        Take the diagnostic
      </a>
      <a href="/contact" class="inline-block border border-accent/40 text-accent font-body text-sm font-semibold tracking-wider uppercase px-8 py-3 rounded-sm hover:border-accent hover:bg-accent/5 transition-all">
        Talk to us directly
      </a>
    </div>
  </section>
</Layout>
