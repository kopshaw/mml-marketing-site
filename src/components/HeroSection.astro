---
import heroBg from '../assets/hero-bg.jpg';
import lionEmblem from '../assets/lion-emblem.png';
import { SITE, STATS } from '../data/site';
---

<section id="home" class="relative min-h-[90vh] flex items-center justify-center overflow-hidden pt-20">
  <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url(${heroBg.src})`}></div>
  <div class="absolute inset-0 bg-background/40"></div>
  <div class="absolute inset-0 gradient-hero"></div>
  <img
    src={lionEmblem.src}
    alt=""
    aria-hidden="true"
    class="absolute right-[-50px] bottom-[-50px] w-[500px] md:w-[700px] opacity-[0.07] pointer-events-none select-none"
  />

  <div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
    <p class="font-body text-sm md:text-base tracking-[0.3em] text-accent uppercase mb-6">
      Built for $500K–$25M Operators
    </p>

    <h1 class="text-6xl md:text-8xl lg:text-9xl font-display leading-[0.95] mb-6 gradient-text normal-case">
      revenue. by. design.
    </h1>

    <p class="font-body text-lg md:text-2xl text-foreground/90 max-w-3xl mx-auto mb-3 leading-relaxed">
      We install the <span class="font-accent text-2xl md:text-3xl text-primary">Rev OS</span> &mdash;
      the Revenue Playbooks Operating System &mdash; into your business so it runs without depending on you.
    </p>
    <p class="font-body text-sm md:text-base text-muted-foreground italic mb-10">
      {SITE.identityLine}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a
        href={SITE.diagnosticUrl}
        class="gradient-accent text-primary-foreground font-body text-base font-semibold tracking-wider uppercase px-10 py-4 rounded-sm glow-accent hover:opacity-90 transition-opacity"
      >
        Take the FREEDOM Diagnostic
      </a>
      <a
        href="/framework"
        class="border border-accent/40 text-accent font-body text-base font-semibold tracking-wider uppercase px-10 py-4 rounded-sm hover:border-accent hover:bg-accent/5 transition-all"
      >
        See the Framework
      </a>
    </div>

    <!-- Top-line proof strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto pt-8 border-t border-border/30">
      {STATS.map((s) => (
        <div class="text-center">
          <div class="font-display text-2xl md:text-3xl gradient-text leading-none">{s.number}</div>
          <div class="font-body text-[10px] md:text-xs tracking-wider uppercase text-muted-foreground mt-1.5">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
