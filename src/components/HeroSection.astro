---
import HeroTypewriter from './HeroTypewriter.tsx';
import heroBg from '../assets/hero-bg.jpg';
import lionEmblem from '../assets/lion-emblem.png';
---

<section id="home" class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-20">
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url(${heroBg.src})`}
  ></div>
  <div class="absolute inset-0 bg-background/40"></div>
  <div class="absolute inset-0 gradient-hero"></div>
  <img
    src={lionEmblem.src}
    alt=""
    aria-hidden="true"
    class="absolute right-[-50px] bottom-[-50px] w-[500px] md:w-[700px] opacity-[0.07] pointer-events-none select-none"
  />

  <div class="relative z-10 text-center px-6 max-w-4xl mx-auto">
    <p class="font-body text-sm md:text-base tracking-[0.3em] text-accent uppercase mb-6">
      Business Coach &middot; Mentor &middot; Speaker
    </p>

    <h1 class="text-5xl md:text-7xl lg:text-8xl font-display leading-[0.95] mb-2 gradient-text normal-case min-h-[120px] md:min-h-[160px] flex items-center justify-center">
      <!-- Static headline for SEO, gets replaced by typewriter on hydration -->
      <HeroTypewriter client:idle />
    </h1>

    <p class="font-body text-lg md:text-xl text-muted-foreground max-w-2xl mx-auto mb-4 leading-relaxed mt-6">
      We install the <span class="font-accent text-2xl md:text-3xl text-primary">Rev OS</span> &mdash;
      the Revenue Playbooks Operating System &mdash; into your business so you can scale with clarity.
    </p>
    <p class="font-body text-sm text-muted-foreground/70 mb-10">
      Powered by the F.R.E.E.D.O.M. Framework
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contact"
        class="gradient-accent text-primary-foreground font-body text-base font-semibold tracking-wider uppercase px-10 py-4 rounded-sm glow-accent hover:opacity-90 transition-opacity"
      >
        Install Rev OS
      </a>
      <a
        href="/framework"
        class="border border-accent/40 text-accent font-body text-base font-semibold tracking-wider uppercase px-10 py-4 rounded-sm hover:border-accent hover:bg-accent/5 transition-all"
      >
        The Framework
      </a>
    </div>
  </div>
</section>
