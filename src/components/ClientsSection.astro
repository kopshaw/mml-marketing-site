---
// Anchor case studies per doc Section 7. Public disclosure level matches the brief.
import { CASE_STUDIES, ICP } from '../data/site';
---

<section class="section-padding bg-secondary/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">Where We&rsquo;ve Installed</p>
      <h2 class="text-4xl md:text-5xl font-display text-foreground mb-4">
        Anchor Engagements
      </h2>
      <p class="font-body text-muted-foreground max-w-2xl mx-auto leading-relaxed">
        Industry-agnostic by design. Same diagnostics, different noun in front of "business."
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-5 mb-16">
      {CASE_STUDIES.map((c) => (
        <article class="bg-card border border-border rounded-sm p-7 hover:border-primary/40 transition-colors">
          <p class="font-body text-xs tracking-wider uppercase text-accent mb-2">{c.industry}</p>
          <h3 class="font-display text-xl text-foreground mb-3">{c.client}</h3>
          {c.metric && (
            <p class="font-body text-3xl font-display gradient-text mb-3">{c.metric}</p>
          )}
          {c.operator && (
            <p class="font-body text-sm text-muted-foreground mb-2">
              <strong class="text-foreground/80">Operator:</strong> {c.operator}
            </p>
          )}
          {c.role && (
            <p class="font-body text-sm text-muted-foreground mb-2">
              <strong class="text-foreground/80">Steve&rsquo;s role:</strong> {c.role}
            </p>
          )}
          <p class="font-body text-sm text-muted-foreground mb-2">
            <strong class="text-foreground/80">Engagement focus:</strong> {c.engagement}
          </p>
          {c.target && (
            <p class="font-body text-sm text-muted-foreground mb-2">
              <strong class="text-foreground/80">Target:</strong> {c.target}
            </p>
          )}
        </article>
      ))}
    </div>

    <div class="border-t border-border/30 pt-12">
      <h3 class="text-2xl md:text-3xl font-display text-foreground text-center mb-8">Verticals We Serve</h3>
      <div class="grid md:grid-cols-2 gap-4">
        {ICP.verticals.map((v) => (
          <div class="bg-card/50 border border-border/50 rounded-sm p-5">
            <p class="font-display text-lg text-foreground mb-1">{v.name}</p>
            <p class="font-body text-xs text-muted-foreground italic">Anchor: {v.anchor}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
