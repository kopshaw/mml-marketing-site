---
import { NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-background border-t border-border px-6 py-12 md:px-12">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="text-center md:text-left">
      <p class="flex items-center gap-2 justify-center md:justify-start">
        <span class="font-display text-2xl tracking-widest text-foreground">METRIC MENTOR</span>
        <span class="font-accent text-3xl text-primary">Labs</span>
      </p>
      <p class="font-body text-sm text-muted-foreground mt-1">{SITE.tagline}</p>
    </div>
    <div class="flex flex-wrap gap-6 justify-center">
      {NAV.map((item) => (
        <a
          href={item.href}
          class="font-body text-sm text-muted-foreground hover:text-primary transition-colors uppercase tracking-wider"
        >
          {item.label}
        </a>
      ))}
    </div>
    <p class="font-body text-xs text-muted-foreground">
      &copy; {year} {SITE.name}. All rights reserved.
    </p>
  </div>
</footer>
