---
// Footer is the comprehensive site map. Every page in the sitemap shows up here
// or via body content. Top nav stays minimal; footer carries the rest.
import { FOOTER_NAV, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-background border-t border-border">
  <div class="max-w-7xl mx-auto px-6 md:px-12 py-14">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-10 mb-10">
      <!-- Brand block -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center gap-2 mb-3">
          <span class="font-display text-xl tracking-widest text-foreground">METRIC MENTOR</span>
          <span class="font-accent text-2xl text-primary">Labs</span>
        </a>
        <p class="font-body text-sm text-muted-foreground mb-2">{SITE.tagline}</p>
        <p class="font-body text-xs italic text-muted-foreground/70">{SITE.identityLine}</p>
      </div>

      <!-- Site map columns -->
      {FOOTER_NAV.map((column) => (
        <div>
          <p class="font-body text-xs tracking-wider uppercase text-primary mb-4">{column.heading}</p>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith('http') ? '_blank' : undefined}
                  rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="font-body text-sm text-muted-foreground hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="pt-8 border-t border-border/50 flex flex-col md:flex-row gap-4 md:items-center md:justify-between">
      <p class="font-body text-xs text-muted-foreground">
        &copy; {year} {SITE.name}. All rights reserved.
      </p>
      <div class="flex flex-wrap gap-4">
        {SITE.founder.sameAs.slice(0, 5).map((url) => {
          const label = url.includes('instagram') ? 'Instagram'
                      : url.includes('tiktok')    ? 'TikTok'
                      : url.includes('youtube')   ? 'YouTube'
                      : url.includes('twitter')   ? 'X'
                      : url.includes('linkedin')  ? 'LinkedIn'
                      : 'Link';
          return (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body text-xs tracking-wider uppercase text-muted-foreground hover:text-primary transition-colors"
            >
              {label}
            </a>
          );
        })}
      </div>
    </div>
  </div>
</footer>
