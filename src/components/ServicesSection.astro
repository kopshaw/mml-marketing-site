---
import { SERVICES } from '../data/site';
import { MessageSquare, Users, TrendingUp, Lightbulb } from 'lucide-react';

const ICONS: Record<string, any> = {
  'rev-os-installation': MessageSquare,
  'leadership-development': Users,
  'revenue-growth-consulting': TrendingUp,
  'strategic-execution-coaching': Lightbulb,
};
---

<section id="services" class="relative section-padding" style="background: hsl(210, 20%, 96%);">
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">What We Do</p>
      <h2 class="text-4xl md:text-6xl font-display" style="color: hsl(215, 30%, 12%);">
        Install <span class="font-accent text-5xl md:text-7xl gradient-text">Rev OS</span> Into Your Business
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {SERVICES.map((service) => {
        const Icon = ICONS[service.slug];
        return (
          <a
            href={`/services/${service.slug}`}
            class="group block border rounded-sm p-8 hover:border-primary/40 transition-all duration-300"
            style="background: white; border-color: hsl(215, 15%, 85%);"
          >
            <Icon className="w-10 h-10 text-primary mb-5 group-hover:scale-110 transition-transform" />
            <h3 class="text-2xl font-display mb-3" style="color: hsl(215, 30%, 12%);">{service.title}</h3>
            <p class="font-body leading-relaxed" style="color: hsl(215, 15%, 40%);">{service.description}</p>
            <p class="font-body text-sm tracking-wider uppercase mt-4 text-primary">Learn more &rarr;</p>
          </a>
        );
      })}
    </div>
  </div>
</section>
