---
// "Sound familiar?" — surfaces the 15 named operational pains from the doc.
// Used on home + /services. Pulls reader into self-recognition; the Rev OS is the answer.
import { PAINS } from '../data/site';

interface Props {
  limit?: number;       // optional cap — homepage shows top 9, services page shows all 15
  heading?: string;
  subhead?: string;
}
const {
  limit = PAINS.length,
  heading = 'Sound familiar?',
  subhead = 'Most $500K–$25M operators are not stuck on demand. They are stuck on infrastructure. Here is what infrastructure-poor businesses look like from the inside.',
} = Astro.props;
const visible = PAINS.slice(0, limit);
---

<section class="section-padding bg-secondary/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <p class="font-body text-sm tracking-[0.3em] text-primary uppercase mb-3">The Diagnosis</p>
      <h2 class="text-4xl md:text-5xl font-display text-foreground mb-4">{heading}</h2>
      <p class="font-body text-muted-foreground max-w-2xl mx-auto leading-relaxed">{subhead}</p>
    </div>

    <ul class="grid md:grid-cols-2 lg:grid-cols-3 gap-3 max-w-6xl mx-auto">
      {visible.map((pain) => (
        <li class="flex gap-3 bg-card/50 border border-border/50 rounded-sm px-4 py-3">
          <span class="text-primary shrink-0 font-display">→</span>
          <span class="font-body text-sm text-foreground/85 leading-relaxed">{pain}</span>
        </li>
      ))}
    </ul>

    {limit < PAINS.length && (
      <p class="text-center mt-8 font-body text-xs text-muted-foreground italic">
        +{PAINS.length - limit} more — your diagnostic will surface which apply most.
      </p>
    )}
  </div>
</section>
